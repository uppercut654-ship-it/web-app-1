{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "993716b3-0d5d-46e0-a65f-2f9efa80c55e","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c93c7e1d884f42a695df20ac6072a0e2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
